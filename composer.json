{
    "name": "doctora/med-clinic-webapp",
    "type": "project",
    "description": "Doctor-A Med Clinic Telegram WebApp & Taplink on Laravel",
    "keywords": ["laravel", "telegram-bot", "webapp", "taplink", "doctor-a"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^10.0 || ^11.0",
        "laravel/sanctum": "^3.2",
        "laravel/tinker": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
